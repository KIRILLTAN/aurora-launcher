{
  "name": "aurora-launcher",
  "productName": "Aurora Launcher",
  "version": "1.2.0",
  "description": "Aurora Launcher — красивый лаунчер Minecraft: сборки, моды, Java-менеджер, редактор скинов и ИИ-анализ крашей",
  "main": "./out/main/index.js",
  "author": "KIRILLTAN",
  "license": "MIT",
  "homepage": "https://github.com/KIRILLTAN/aurora-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/KIRILLTAN/aurora-launcher.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9",
    "tar": "^7.4.3",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.1",
    "@types/yauzl": "^2.10.3"
  }
}
